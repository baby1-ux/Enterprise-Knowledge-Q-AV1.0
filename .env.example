# 复制为 .env 后填写，.env 不会被提交
# ---------------------------------------------------------------------------
# 对话大模型：DeepSeek（必填）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-请替换为你的DeepSeek-API-Key

# ---------------------------------------------------------------------------
# 向量化 / 重排 / 图片 OCR：DashScope（必填，除非把 embedding.provider 改成
# local_bge_m3 或 hash）
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-请替换为你的DashScope-API-Key

# MySQL root 密码（需与 docker-compose.yml 中一致）
MYSQL_PASSWORD=123456

# Milvus 地址
MILVUS_HOST=127.0.0.1
